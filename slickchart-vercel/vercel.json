{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "node scripts/build-app-split.cjs",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-checkins",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron-nurture",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron-automations",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron-events",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron-orphan-checkout",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron-provider-reminders",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/client",
      "destination": "/api/client-page"
    },
    {
      "source": "/client/:token",
      "destination": "/api/client-page?token=:token"
    },
    {
      "source": "/slickchart-space",
      "destination": "/api/client-page"
    },
    {
      "source": "/space",
      "destination": "/api/client-page"
    },
    {
      "source": "/space/:token",
      "destination": "/api/client-page?token=:token"
    },
    {
      "source": "/consult/:slug",
      "destination": "/api/consult-page?slug=:slug"
    },
    {
      "source": "/book/:slug",
      "destination": "/api/book-page?slug=:slug"
    },
    {
      "source": "/build/unlocked",
      "destination": "/build-unlocked"
    },
    {
      "source": "/build/blog",
      "destination": "/build-blog"
    },
    {
      "source": "/build/blog/:slug",
      "destination": "/build-blog/:slug"
    },
    {
      "source": "/build/access",
      "destination": "/build-access"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/assetlinks"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/apple-app-site-association"
    },
    {
      "source": "/apple-app-site-association",
      "destination": "/api/apple-app-site-association"
    }
  ],
  "headers": [
    {
      "source": "/assets/app-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/ec-9308d13917a6f75f4f385060/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/lb-a5025eda48748f3494bcacd7/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/hs-cd08c7917b34626fe2a21967/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/pm-8881ba4d736d7954ddb1e516/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/na-97315595add70d4ee045ac48/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/mt-22356de748488743d57612cf/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/hd-d5b1a5175d2a99be58ea00a7/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/tt-fb05b651380857fa70db4e8c/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    }
  ]
}
