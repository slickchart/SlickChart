{
  "name": "slickchart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SlickChart — practice management app with a live Square link and cloud sync (Postgres/Neon).",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.3",
    "@neondatabase/serverless": "^0.10.4",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "build:blog": "node scripts/build-blog.cjs",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
