{
  "appId": "com.slickchart.app",
  "appName": "SlickChart",
  "webDir": "native-shell",
  "server": {
    "url": "https://slickchart.app/slickchart",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 88
  }
}
