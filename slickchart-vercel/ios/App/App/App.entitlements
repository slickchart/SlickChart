<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: lets the app claim slickchart.app links (a client's /client/<token> magic
	     link opens the app instead of Safari). Requires the "Associated Domains" capability enabled on
	     the App ID / provisioning profile, and /.well-known/apple-app-site-association served on the site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:slickchart.app</string>
	</array>
</dict>
</plist>
