<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: open https://slickchart.app/client... (a client's magic link) IN the app
                 instead of the browser. autoVerify makes Android check /.well-known/assetlinks.json for
                 this package's signing fingerprint before it will open links without a chooser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="slickchart.app" android:pathPrefix="/client" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Notification appearance. Without these, Android falls back to the launcher icon and
             flattens it to a solid white blob in the status bar, indistinguishable from every other
             app's circle. ic_stat_notify is a bold monochrome lotus drawn for 24dp. Firebase reads
             both keys for messages that arrive while the app is backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/sc_notification_accent" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone: powers hands-free voice dictation of treatment notes. Without this, the WebView
         cannot grant the page mic access and dictation fails with "microphone blocked" even when the
         OS-level app permission looks fine. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Declaring RECORD_AUDIO makes Play imply a REQUIRED microphone feature, which would drop
         devices without a mic (mic-less tablets/TV devices) from the listing. Dictation is optional
         (the app degrades to typing), so mark the feature not-required to keep full device reach. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
