<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <!-- Pad the lotus into Android's safe zone so round / squircle launcher masks don't clip the
         diagonal leaf tips. The foreground art reached ~35% from center at the diagonals (just past
         the ~33% safe circle); a 10% inset pulls everything comfortably inside. -->
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="10%"/>
    </foreground>
</adaptive-icon>
